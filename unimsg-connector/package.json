{
  "name": "unimsg-connector",
  "private": true,
  "version": "1.0.0",
  "description": "多平台连接器与统一消息管理 — 赛题A 竞赛项目（后端：成员A）",
  "scripts": {
    "dev": "pnpm --filter @unimsg/server dev",
    "start": "pnpm --filter @unimsg/server start",
    "doctor": "pnpm --filter @unimsg/server run doctor",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @unimsg/server test",
    "test:web": "pnpm --filter @unimsg/web test",
    "e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e.ps1",
    "e2e:sh": "bash scripts/e2e.sh",
    "deliver": "node scripts/deliver.mjs"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}

