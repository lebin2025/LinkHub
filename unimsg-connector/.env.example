# ============================================================
# LinkHub 环境变量模板（复制为 .env 后按实际账号填写）
#
# 核心：换账号只改本文件，不改代码。
#  - 未配置凭据的平台会自动走本地 Mock，并在 API/UI 标注「模拟发送」；
#  - 填完建议先跑 `pnpm run doctor` 自检（凭据/网络/出口 IP/修复建议）。
# ⚠️ 所有 *SECRET / *KEY / *TOKEN 都是【服务端私有】凭据，
#    绝不以前缀 VITE_ 注入前端，前端拿不到任何真实密钥。
# ============================================================

# ---- 服务 ----
SERVER_PORT=3001
# 入口鉴权令牌（默认 dev-token，换环境务必修改）
API_TOKEN=dev-token

# ---- 存储（留空=内存模式，无需 Docker 即可本地验证）----
# 部署评审环境时填写，例如：postgres://u:p@postgres:5432/unimsg
DATABASE_URL=
REDIS_URL=

# ============================================================
# 运行模式（可替换性核心）
#   auto = 默认：凭据够就走真实接口，不够走本地 Mock
#   real = 强制真实接口（凭据不全时发送会显式报错，绝不静默假成功）
#   mock = 强制本地模拟（即使填了凭据也不外呼，适合离线演示）
# 旧变量 MOCK 已废弃：只在没写 *_MODE 时作为默认策略，并在启动日志警告。
# ============================================================
FEISHU_MODE=auto
DINGTALK_MODE=auto
WECOM_MODE=auto
MAIL_MODE=auto
# 纯本地演示（零账号、不连任何外网）时，取消下面四行注释即可：
# FEISHU_MODE=mock
# DINGTALK_MODE=mock
# WECOM_MODE=mock
# MAIL_MODE=mock

# ---- 边界降级参数 ----
OCR_CONFIDENCE_THRESHOLD=0.7
SEND_MAX_RETRY=3
RETRY_BASE_MS=1000
LLM_TIMEOUT_MS=8000

# ---- 大模型（意图识别 / 摘要 / 回复草稿，真实调用尚未实现，保持 mock 即可）----
# provider: mock(默认) | wenxin(文心) | qwen(通义)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_ENDPOINT=

# ---- OCR（图片/文件文字提取，真实调用尚未实现，保持 mock 即可）----
# provider: mock(默认) | tencent(腾讯云)
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_SECRET_ID=

# ---- 飞书（自建应用；开发者后台 → 凭证与基础信息 / 事件与回调 → 加密策略）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFY_TOKEN=
FEISHU_ENCRYPT_KEY=
# 国际版 Lark / 代理网关可覆盖（一般不用改）
# FEISHU_BASE_URL=https://open.feishu.cn

# ---- 钉钉（企业内部应用；开发者后台 → 凭证与基础信息 / 应用能力 → 机器人）----
# 新版后台叫 Client ID / Client Secret；旧版叫 AppKey / AppSecret（两种都支持）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 机器人编码，企业内部应用通常与 Client ID 相同（留空自动取 Client ID）
DINGTALK_ROBOT_CODE=
# HTTP 回调模式才需要（事件订阅的 Token / 加密密钥）
DINGTALK_AES_TOKEN=
DINGTALK_AES_KEY=
# Stream 长连接：true 时本机无需公网回调即可收机器人消息
# 需在「应用能力 → 机器人」把消息接收模式选为 Stream 并发布版本
DINGTALK_STREAM=false
# DINGTALK_BASE_URL=https://api.dingtalk.com

# ---- 企业微信（自建应用）----
# 应用管理 → 自建 → 应用详情页取 AgentId / Secret（Secret 点「眼睛」查看，切勿点重置）
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# 该应用「接收消息 → 设置 API 接收」的 Token 与随机生成的 EncodingAESKey（43 位）
WECOM_TOKEN=
WECOM_AES_KEY=
# 发信出口 IP 必须加入「企业可信IP」，否则报 60020（pnpm run doctor 会显示当前出口 IP）
# WECOM_BASE_URL=https://qyapi.weixin.qq.com

# ============================================================
# 邮箱数据源：任意数量、任意服务商（IMAP 收 + SMTP 发，免公网回调）
#  1) 自动发现（推荐）：填 MAIL_<KEY>_ADDRESS / MAIL_<KEY>_AUTH_CODE，
#     KEY 可随意取（qq / 163 / work / school2 …），可配多个账号；
#  2) 也可用 MAIL_ACCOUNTS=qq,163,work 显式声明要启用的账号：
#     写了它就只加载列出的 key，未列出的即使填了 ADDRESS/AUTH_CODE 也不会启用。
# 授权码 ≠ 网页登录密码：需先在网页端开启 IMAP/SMTP 服务并生成授权码。
# 反垃圾可能把回信扔进垃圾箱：用 MAIL_<KEY>_FOLDERS=INBOX,Junk 一起监听。
# ============================================================
MAIL_POLL_SECONDS=45
# 兼容旧变量：不填 = 有账号就开启轮询；false = 只发不收
# MAIL_ENABLED=true

# 账号一：QQ 邮箱（内置预设 imap.qq.com:993 / smtp.qq.com:465）
# QQ：设置 → 账号与安全 → 安全设置 → POP3/IMAP/SMTP 服务 → 开启并生成授权码
MAIL_QQ_ADDRESS=
MAIL_QQ_AUTH_CODE=
MAIL_QQ_FOLDERS=INBOX

# 账号二：网易 163（内置预设 imap.163.com:993 / smtp.163.com:465）
# 163：设置 → POP3/SMTP/IMAP → 开启服务 → 新增授权密码（只显示一次）
MAIL_163_ADDRESS=
MAIL_163_AUTH_CODE=
MAIL_163_FOLDERS=INBOX

# 账号三示例：任意服务商（126 / yeah / gmail / outlook / icloud 有内置预设，其他用 custom）
# MAIL_WORK_ADDRESS=me@company.com
# MAIL_WORK_AUTH_CODE=授权码
# MAIL_WORK_PROVIDER=custom            # qq | 163 | 126 | yeah | gmail | outlook | icloud | custom
# MAIL_WORK_LABEL=公司邮箱
# MAIL_WORK_IMAP_HOST=imap.company.com
# MAIL_WORK_SMTP_HOST=smtp.company.com
# 端口/加密方式一般不用写；写了会覆盖预设：
#   993 / 465 = 隐式 TLS（默认）；143 / 587 / 25 = STARTTLS
# MAIL_WORK_IMAP_PORT=993
# MAIL_WORK_SMTP_PORT=587
# MAIL_WORK_IMAP_SECURE=true
# MAIL_WORK_SMTP_SECURE=false
# MAIL_WORK_FOLDERS=INBOX,Junk
