# ============================================================
# 多平台连接器 · 环境变量模板（复制为 .env 后填写）
# ⚠️ 所有 *SECRET / *KEY / *TOKEN 均为【服务端私有】凭据，
#    绝不以前缀 VITE_ 注入前端，前端拿不到任何真实密钥。
# ============================================================

# ---- 服务 ----
SERVER_PORT=3001

# ---- 存储（留空=内存模式，无需 Docker 即可本地验证）----
# 部署评审环境时填写，例如：postgres://u:p@postgres:5432/unimsg
DATABASE_URL=
REDIS_URL=

# ---- 外部 API 总开关 ----
# true  = 三平台发送/验签、LLM、OCR 全部走 Mock（默认，零账号可跑）
# false = 使用下方填写的真实密钥调用真实接口
MOCK=true

# ---- 大模型（意图识别 / 摘要 / 回复草稿）----
# provider: mock(默认) | wenxin(文心) | qwen(通义)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_ENDPOINT=

# ---- OCR（图片/文件文字提取）----
# provider: mock(默认) | tencent(腾讯云)
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_SECRET_ID=

# ---- 飞书 ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFY_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---- 钉钉 ----
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AES_TOKEN=
DINGTALK_AES_KEY=

# ---- 企业微信 ----
WECOM_TOKEN=
WECOM_AES_KEY=
WECOM_CORP_ID=
WECOM_AGENT_ID=
