# ============================================================
# 多平台连接器 · 环境变量模板（复制为 .env 后填写）
# ⚠️ 所有 *SECRET / *KEY / *TOKEN 均为【服务端私有】凭据，
#    绝不以前缀 VITE_ 注入前端，前端拿不到任何真实密钥。
# ============================================================

# ---- 服务 ----
SERVER_PORT=3001
# 入口鉴权令牌（默认 dev-token，生产务必修改）
API_TOKEN=dev-token

# ---- 存储（留空=内存模式，无需 Docker 即可本地验证）----
# 部署评审环境时填写，例如：postgres://u:p@postgres:5432/unimsg
DATABASE_URL=
REDIS_URL=

# ---- 外部 API 总开关 ----
# true  = 三平台发送/验签、LLM、OCR 全部走 Mock（默认，零账号可跑）
# false = 使用下方填写的真实密钥调用真实接口（飞书/钉钉适配器已实现；企微仍为 Mock）
MOCK=true

# ---- 边界降级参数 ----
OCR_CONFIDENCE_THRESHOLD=0.7
SEND_MAX_RETRY=3
RETRY_BASE_MS=1000
LLM_TIMEOUT_MS=8000

# ---- 大模型（意图识别 / 摘要 / 回复草稿）----
# provider: mock(默认) | wenxin(文心) | qwen(通义)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_ENDPOINT=

# ---- OCR（图片/文件文字提取）----
# provider: mock(默认) | tencent(腾讯云)
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_SECRET_ID=

# ---- 飞书（开发者后台 → 凭证与基础信息 / 事件与回调 → 加密策略）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFY_TOKEN=
FEISHU_ENCRYPT_KEY=

# ---- 钉钉（开发者后台 → 凭证与基础信息 / 机器人 / 事件订阅）----
# 新版后台叫 Client ID / Client Secret；旧版叫 AppKey / AppSecret（两种都支持）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 机器人编码，企业内部应用通常与 Client ID 相同
DINGTALK_ROBOT_CODE=
DINGTALK_AES_TOKEN=
DINGTALK_AES_KEY=
# Stream 长连接：true 时无需公网回调，直接接收机器人消息
# 需在「应用能力 → 机器人」把消息接收模式选为 Stream 并发布版本
DINGTALK_STREAM=false

# ---- 企业微信 ----
# 回调「接收消息」配置：Token 自填、EncodingAESKey 随机生成（43 位），仅用于验签+解密
WECOM_TOKEN=
WECOM_AES_KEY=
# 我的企业 → 企业ID（未认证团队在「我的团队 → 团队信息」显示为团队ID）
WECOM_CORP_ID=
# 应用管理 → 自建应用详情页的 AgentId
WECOM_AGENT_ID=
# 应用详情页的 Secret（换 access_token 用，点「眼睛」查看；切勿点重置）
WECOM_SECRET=

# ---- 邮箱（QQ / 163）：IMAP 收 + SMTP 发，免公网回调 ----
# 授权码 ≠ 网页登录密码：需先在网页端开启 IMAP/SMTP 服务并生成授权码
# QQ：设置 → 账号与安全 → POP3/IMAP/SMTP 服务 → 开启（要先绑手机号+发短信）
# 163：设置 → POP3/SMTP/IMAP → 开启服务 → 新增授权密码
MAIL_ENABLED=false
MAIL_POLL_SECONDS=45
MAIL_QQ_ADDRESS=
MAIL_QQ_AUTH_CODE=
# 一般不用改：imap.qq.com / smtp.qq.com（465 隐式 TLS）
MAIL_QQ_IMAP_HOST=imap.qq.com
MAIL_QQ_SMTP_HOST=smtp.qq.com
MAIL_163_ADDRESS=
MAIL_163_AUTH_CODE=
MAIL_163_IMAP_HOST=imap.163.com
MAIL_163_SMTP_HOST=smtp.163.com
# 监听目录（逗号分隔），默认只收 INBOX；反垃圾把信扔进垃圾箱时可写 INBOX,Junk
MAIL_QQ_FOLDERS=INBOX
MAIL_163_FOLDERS=INBOX
